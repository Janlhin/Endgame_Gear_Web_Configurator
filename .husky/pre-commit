#!/bin/sh
# 薄壳：唯一动作是转发，不含任何业务逻辑（规范 v1.21.0 §脚本执行基线）。
# 逻辑在 scripts/hooks/pre-commit.ps1 —— 钩子的失败判定必须与 npm run verify 同源，
# 否则同一份改动会在「本地说通过、CI 说失败」之间来回拉。
# 原先是把 5 条 npm 命令直接写在 sh 里，等于给钩子留了第二套语义；
# 2026-11-09 改为纯转发（DECISIONS.md D-005）。
# 不用 --no-verify 绕过；钩子误报就改钩子。
exec pwsh -NoLogo -NoProfile -File "$(dirname "$0")/../scripts/hooks/pre-commit.ps1" "$@"
