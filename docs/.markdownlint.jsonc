{
  // docs/ 目录级配置。就近生效——markdownlint 会为每个文件读取最近的
  // .markdownlint.jsonc。
  //
  // ⚠️ 目录级配置是**替换**而非合并（实测：只写 MD036 会让根配置里的
  // MD013/MD060/MD033 豁免全部失效，MD060 立刻报出 100+ 条）。
  // 因此这里必须把根配置的三项全局豁免**重复声明一遍**，
  // 两处保持同步。改动根配置豁免项时，务必回到此文件同步。
  //
  // 继承根配置的三项全局豁免（理由见根 .markdownlint-cli2.jsonc）：
  //   MD013 行长 —— 中文宽字符与表格，80列会迫使作者拆句
  //   MD060 表格列对齐 —— 本项目表格以人工对齐可读为优先
  //   MD033 内联 HTML —— README 用<kbd>/<br>/<sub> 做排版
  "MD013": false,
  "MD060": false,
  "MD033": false,

  // 本目录专属豁免：MD036。
  // test-checklist.md 会被 tools/md2html.mjs 渲染进 index.html 的清单卡，
  // 而该渲染器把 Markdown 标题整体降级（h1 → h3，见 md2html.mjs:41）。
  // 因此作者用 `**粗体**` 作小标题是刻意的排版选择，渲染为 <strong> 后
  // 语义正确；改成### 会被映射成 h5，视觉层级过重。
  "MD036": false
}